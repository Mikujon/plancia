# Server
API_PORT=8787
PLANCIA_DB=data/plancia.db

# Tokens accepted on the public API /api/ops/v1 (comma-separated). Nodo uses one of these.
PLANCIA_API_TOKENS=change-me-nodo-token

# Chat webhooks: shared secrets checked on inbound calls
TELEGRAM_WEBHOOK_SECRET=change-me
GOOGLE_CHAT_WEBHOOK_TOKEN=change-me

